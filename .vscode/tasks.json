{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-c-console",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g", "-std=c11", "-Wall",
                "${file}",
                "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": { "cwd": "${fileDirname}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [ "$gcc" ],
            "detail": "纯 C 控制台程序（gcc，不链接任何图形库）"
        },
        {
            "label": "build-easyx",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g", "-std=c++17",
                "${file}",
                "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-leasyx", "-lgdi32"
            ],
            "options": { "cwd": "${fileDirname}" },
            "group": "build",
            "problemMatcher": [ "$gcc" ],
            "detail": "C++ + EasyX 图形程序"
        }
    ]
}