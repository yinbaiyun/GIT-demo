{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-raylib",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g", "-std=c17", "-Wall",
                "${file}",
                "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lraylibdll", "-lopengl32", "-lgdi32", "-lwinmm"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [ "$gcc" ],
            "detail": "C 文件 + raylib（gcc，D:\\mingw64 里的 raylib DLL 版）"
        },
        {
            "label": "build-easyx",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g", "-std=c++17",
                "${file}",
                "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-leasyx", "-lgdi32"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": [ "$gcc" ],
            "detail": "C++ 文件 + EasyX（g++，EasyX 只支持 C++）"
        }
    ]
}